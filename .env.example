# =============================================================================
# School Management System - environment example
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=1
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL --------------------------------------------------------------
DATABASE_URL=postgresql://sms:sms_password@localhost:5432/sms?schema=public&connection_limit=20

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth / JWT --------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
ENCRYPTION_KEY=change-me-32-byte-base64-encryption-key=

# --- MFA ---------------------------------------------------------------------
MFA_ISSUER=SchoolManagement

# --- Cloudinary (image/media) ------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=sms

# --- S3-compatible private storage (sensitive docs) --------------------------
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=sms-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Email (SMTP) ------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="School Management <no-reply@example.com>"

# --- SMS (optional) ----------------------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Payments (optional, backend-only secrets) -------------------------------
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Rate limiting -----------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# --- Seed (development only) -------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!12345
SEED_DEFAULT_ORG_NAME=Demo Education Group
